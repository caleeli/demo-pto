        <bpmn:flowNodeRef>node_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>node_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="node_15" name="Reviewer">
        <bpmn:flowNodeRef>node_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>node_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>node_7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="node_1" name="End Event" pm:screenRef="" pm:elementDestination='{"type":"summaryScreen","value":null}'>
      <bpmn:incoming>node_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="node_2" name="End Event" pm:screenRef="" pm:elementDestination='{"type":"summaryScreen","value":null}'>
      <bpmn:incoming>node_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="node_3" name="Start Event"
      pm:allowInterstitial="false"
      pm:interstitialScreenRef=""
      pm:elementDestination='{"type":"taskList","value":null}'
      pm:assignment="requester"
      pm:assignedUsers="" pm:assignedGroups=""
      pm:config='{"web_entry":null}'>
      <bpmn:outgoing>node_11</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="node_4" name="Submit Investor Confirmation Form"
      pm:screenRef="${screen:slfi-process-upload-investors-confirmation}"
      pm:allowInterstitial="false"
      pm:interstitialScreenRef=""
      pm:elementDestination='{"type":"taskSource","value":null}'
      pm:assignment="requester"
      pm:assignedUsers="" pm:assignedGroups=""
      pm:assignmentLock="false" pm:allowReassignment="false"
      pm:config='{"edit_comments":false,"email_notifications":{"notifications":[]},"reactions":false,"remove_comments":false,"voting":false,"web_entry":null}'>
      <bpmn:incoming>node_11</bpmn:incoming>
      <bpmn:incoming>node_9</bpmn:incoming>
      <bpmn:outgoing>node_10</bpmn:outgoing>
    </bpmn:task>
