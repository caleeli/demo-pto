    <bpmn:sequenceFlow id="node_8" sourceRef="node_6" targetRef="node_7"/>
    <bpmn:sequenceFlow id="node_10" sourceRef="node_4" targetRef="node_6"/>
    <bpmn:sequenceFlow id="node_11" sourceRef="node_3" targetRef="slfi_script_init"/>
    <bpmn:scriptTask id="slfi_script_init" name="Initialize case"
      pm:scriptRef="${script:slfi-process-initialize-upload-task}">
      <bpmn:incoming>node_11</bpmn:incoming>
      <bpmn:outgoing>node_11a</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="node_11a" sourceRef="slfi_script_init" targetRef="node_4"/>
    <bpmn:sequenceFlow id="node_12" sourceRef="node_5" targetRef="node_2"/>
