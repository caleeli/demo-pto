      pm:scriptRef="${script:slfi-process-load-tracking-grid}">
      <bpmn:incoming>node_14</bpmn:incoming>
      <bpmn:outgoing>node_14a</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="node_14" name="To tracking" sourceRef="node_7" targetRef="slfi_script_track">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">SLFI_FLAG_CANCEL_CASE = ""</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="node_14a" sourceRef="slfi_script_track" targetRef="node_5"/>
    <bpmn:sequenceFlow id="node_13" name="Cancel or submit end" sourceRef="node_7" targetRef="node_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">SLFI_FLAG_CANCEL_CASE != "" and SLFI_FLAG_CANCEL_CASE != "RETURN"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="node_9" name="Return to upload" sourceRef="node_7" targetRef="node_4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">SLFI_FLAG_CANCEL_CASE = "RETURN"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
