        <tri_uid>55866861160cd006ce5a4d9064536381</tri_uid>
        <tri_title>Set Min date to expiration Date</tri_title>
        <tri_description>Set Min date to expiration Date</tri_description>
        <pro_uid>49495392760ca7026529f80008442485</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[/***********************************
* Set Min date to expiration Date
* by Ana Castillo
***********************************/
//Get number of days of the Expiration date min value
$sQMinDays = "SELECT SME_DAYS
              FROM PMT_SLFI_MIN_EXPIRATION_DATE
			  WHERE SME_STATUS = 'ACTIVE'";
$rQMinDays = executeQuery($sQMinDays);
$minDays = 0;
if (count($rQMinDays) > 0) {
	$minDays = $rQMinDays[1]['SME_DAYS'];
}
$minDate = date('Y-m-d', strtotime("+" . $minDays . " days"));
@@SLFI_MIN_EXPIRATION_DATE = $minDate;
@@SLFI_EXPIRATION_DATE = $minDate;]]></tri_webbot>
