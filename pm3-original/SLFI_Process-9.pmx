        <pro_uid>49495392760ca7026529f80008442485</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[/**************************************
* Clean table when cancel the case
* by Ana Castillo
* Modified by Helen Callisaya
**************************************/
if (@@SLFI_FLAG_CANCEL_CASE != "" && @@SLFI_FLAG_CANCEL_CASE != "RETURN") {
	$appUid = @@APPLICATION;
	$sQDelete = "DELETE FROM PMT_SLFI_INVESTORS_DATA
	             WHERE APP_UID = '$appUid'";
	executeQuery($sQDelete);
}

]]></tri_webbot>
