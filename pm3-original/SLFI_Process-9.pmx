      <record>
        <dyn_uid>52437100460df88f44e3f49053436605</dyn_uid>
        <dyn_title>Tracking Form</dyn_title>
        <dyn_description>Track the Bulk email sent to the investors</dyn_description>
        <pro_uid>49495392760ca7026529f80008442485</pro_uid>
        <dyn_type>xmlform</dyn_type>
        <dyn_filename><![CDATA[49495392760ca7026529f80008442485/52437100460df88f44e3f49053436605]]></dyn_filename>
        <dyn_content><![CDATA[{"name":"Tracking Form","description":"Track the Bulk email sent to the investors","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"52437100460df88f44e3f49053436605","name":"Tracking Form","description":"Track the Bulk email sent to the investors","mode":"edit","script":{"type":"js","code":"$(document).ready(function() {\n    //Remove backward and forward buttons\n    $(\"#dyn_forward\").parent().hide();\n  \n    //Set libraries\n    var random = Math.random();\n    $(\"head\").append('<script type=\"text/javascript\" src=\"/plugin/psSLFIFunctions/js/javascriptLibrary.js?random=\"' + random + '\" />');\n    $(\"head\").append('<link rel=\"stylesheet\" href=\"/plugin/psSLFIFunctions/css/cssDynaformNorthleaf.css?random=\"' + random + '\"\">');\n  \n    //Check if button to send investors PDFs should be disabled\n    var disabledInvestorsPDFButton = $(\"#SLFI_DISABLED_BUTTON_INVESTORS_ZIP\").getValue();\n    if (disabledInvestorsPDFButton == 1) {\n        $(\"#BTN_SEND_EMAIL_WITH_PDF button\").attr(\"disabled\", \"disabled\");\n    }\n  \n    //Add buttons to the grid\n    var nRows = $(\"#SLFI_INVESTORS_GRID_TRACKING\").getNumberRows();\n    for (var row = 1; row <= nRows; row++) {\n        showHideButtonsGrid(row);\n    }\n  \n    //Show or hide submit button\n    var flagSubmit = $(\"#SLFI_FLAG_SUBMIT\").getValue();\n    if (flagSubmit == \"NO\") {\n        $(\"#SUBMIT\").parent().parent().hide();\n    }\n  \n    sendReminder(1);\n    $(\"#BTN_SEND_REMINDER\").find(\"button\").on(\"click\" , function() {\n        //Confirm the user wants to send the reminder\n        var body = \"<p>Are you sure to send a reminder to all pending investors?</p>\";\n        confirmMessage(\"reminderModal\", \"SEND REMINDER\", body, \"modalReminderYes\", \"modalReminderNo\");\n        $(\"#modalReminderYes\").on(\"click\", function() {\n            $(\"#52437100460df88f44e3f49053436605\").showFormModal();\n            sendReminder(0);\n        });\n    });\n  \n    $(\"#BTN_SEND_EMAIL_WITH_PDF\").find(\"button\").on(\"click\" , function() {\n        $(\"#52437100460df88f44e3f49053436605\").showFormModal();\n        $.ajax({\n            type: \"POST\",\n            url: \"../psSLFIFunctions/investorsController.php\",\n            data: {type: \"sendEmailWithPDFs\",\n                   appUid: $(\"#APP_UID\").getValue()},\n            dataType: 'JSON',\n            cache: false\n        }).done(function(data) {\n            $(\"#52437100460df88f44e3f49053436605\").hideFormModal();\n            if (!data[\"success\"]) {\n                alertMessage(\"errorPDFModal\", \"WARNING\", \"The email with the documents could not be sent, please contact your system administrator\", 1, \"\");\n            } else {\n                alertMessage(\"successPDF\", \"INFO\", \"The email with the documents was successfully sent, remember that the file will be available only for one day and the button will be disabled that period of time.\", 1, \"\");\n                $(\"#BTN_SEND_EMAIL_WITH_PDF button\").attr(\"disabled\", \"disabled\");\n            }\n        });\n    });\n});\n\n/**\n * Show or hide buttons of the grid\n * \n * @param (String) gridRow\n * @return none\n *\n * by Ana Castillo\n * modified by Cinthia Romero\n */\nfunction showHideButtonsGrid(gridRow)\n{\n    //Set flags to show or not buttons\n    var flagView = false;\n    var flagCancel = false;\n    var flagResent = false;\n    var flagEdit = false;\n    var flagCopyLink = false;\n\n    //Get current status\n    var status = $(\"#SLFI_INVESTORS_GRID_TRACKING\").getValue(gridRow, 8);\n\n    //Set variables\n    switch (status) {\n        case 'Sent':\n        case 'Re-sent':\n            flagCancel = true;\n            flagResent = true;\n            flagEdit = true;\n            flagCopyLink = true;\n            break;\n        case 'Completed':\n        case 'Completed Manually':\n            flagView = true;\n            flagResent = true;\n            flagEdit = true;\n            break;\n    }\n\n    if (flagView) {\n        document.getElementById(\"[SLFI_INVESTORS_GRID_TRACKING][\" + gridRow + \"][SLFI_GRID_INVESTORS_VIEW]\").innerHTML = \"<span class='glyphicon glyphicon-search buttonsGrid' title='View' id='VIEW_\" + gridRow + \"' onclick='viewExternalForm(this)'>\";\n    } else {\n        document.getElementById(\"[SLFI_INVESTORS_GRID_TRACKING][\" + gridRow + \"][SLFI_GRID_INVESTORS_VIEW]\").innerHTML = \"\";\n    }\n\n    if (flagCancel) {\n        document.getElementById(\"[SLFI_INVESTORS_GRID_TRACKING][\" + gridRow + \"][SLFI_GRID_INVESTORS_CANCEL]\").innerHTML = \"<span class='glyphicon glyphicon-ban-circle bigButtonsGrid' title='Cancel' id='CANCEL_\" + gridRow + \"' onclick='cancelExternalForm(this)'>\";\n    } else {\n        document.getElementById(\"[SLFI_INVESTORS_GRID_TRACKING][\" + gridRow + \"][SLFI_GRID_INVESTORS_CANCEL]\").innerHTML = \"\";\n    }\n\n    if (flagResent) {\n        document.getElementById(\"[SLFI_INVESTORS_GRID_TRACKING][\" + gridRow + \"][SLFI_GRID_INVESTORS_RESENT]\").innerHTML = \"<span class='glyphicon glyphicon-envelope bigButtonsGrid' title='Re-send' id='RESENT_\" + gridRow + \"' onclick='reSentExternalForm(this)'>\";\n    } else {\n        document.getElementById(\"[SLFI_INVESTORS_GRID_TRACKING][\" + gridRow + \"][SLFI_GRID_INVESTORS_RESENT]\").innerHTML = \"\";\n    }\n\n    if (flagEdit) {\n        document.getElementById(\"[SLFI_INVESTORS_GRID_TRACKING][\" + gridRow + \"][SLFI_GRID_INVESTORS_EDIT]\").parentNode.parentNode.style.display = \"inline-block\";\n        document.getElementById(\"[SLFI_INVESTORS_GRID_TRACKING][\" + gridRow + \"][SLFI_GRID_INVESTORS_EDIT]\").parentNode.parentNode.style.width = \"3%\";\n        document.getElementById(\"[SLFI_INVESTORS_GRID_TRACKING][\" + gridRow + \"][SLFI_GRID_INVESTORS_EDIT]\").innerHTML = \"<span class='glyphicon glyphicon-pencil bigButtonsGrid' title='Edit' id='EDIT_\" + gridRow + \"' onclick='editExternalForm(this)'>\";\n    } else {\n        document.getElementById(\"[SLFI_INVESTORS_GRID_TRACKING][\" + gridRow + \"][SLFI_GRID_INVESTORS_EDIT]\").innerHTML = \"\";\n    }\n  \n    if (flagCopyLink) {\n        document.getElementById(\"[SLFI_INVESTORS_GRID_TRACKING][\" + gridRow + \"][SLFI_GRID_INVESTORS_COPY_LINK]\").parentNode.parentNode.style.display = \"inline-block\";\n        document.getElementById(\"[SLFI_INVESTORS_GRID_TRACKING][\" + gridRow + \"][SLFI_GRID_INVESTORS_COPY_LINK]\").parentNode.parentNode.style.width = \"3%\";\n        document.getElementById(\"[SLFI_INVESTORS_GRID_TRACKING][\" + gridRow + \"][SLFI_GRID_INVESTORS_COPY_LINK]\").innerHTML = \"<span class='glyphicon glyphicon-link bigButtonsGrid' title='Copy Link' id='COPY_LINK_\" + gridRow + \"' onclick='copyLink(this, \" + gridRow + \")'>\";\n    } else {\n        document.getElementById(\"[SLFI_INVESTORS_GRID_TRACKING][\" + gridRow + \"][SLFI_GRID_INVESTORS_COPY_LINK]\").innerHTML = \"\";\n    }\n}\n/**\n * View External Form answer\n * \n * @param (Object) objView\n * @return none\n *\n * by Ana Castillo\n * modified by Cinthia Romero\n */\nfunction viewExternalForm(objView)\n{\n    //Get ssid\n    var idView = objView.id;\n    var rowNumber = idView.split(\"_\")[1];\n    var investorClueExternalForm = $(\"#SLFI_INVESTORS_GRID_TRACKING\").getValue(rowNumber, 14);\n    var encryptedInvestorClue = btoa(investorClueExternalForm);\n  \n    //Set link of the External Form\n    var externalLink = $(\"#SLFI_EXTERNAL_FORM\").getValue();\n    externalLink += \"?identifier=\" + encryptedInvestorClue + \"&type=VIEW\";\n  \n    var ssid = $(\"#SLFI_INVESTORS_GRID_TRACKING\").getValue(rowNumber, 6);\n  \n    //Set generate document function\n    var generateDocument = \"generateDocument('\" + $(\"#APP_UID\").getValue() + \"', '\" + ssid + \"')\";\n\n    //Create modal html\n    $(\"#modalView\").remove();\n    var htmlModal = '<div id=\"modalView\" class=\"modal fade\"\">';\n    htmlModal += '<div class=\"modal-dialog bigModal\" style=\"width:90%;\">';\n    htmlModal += '<div class=\"modal-content bigModal\">';\n    htmlModal += '<div class=\"modal-header modalTitleColors\">';\n    htmlModal += '<center>';\n    htmlModal += '<b>Edit External Form</b>';\n    htmlModal += '</center>';\n    htmlModal += '</div>';\n    htmlModal += '<div id=\"bodyModal\" class=\"modal-body bigModal\">';\n    htmlModal += '<p><iframe id=\"externalform\" src=\"' + externalLink + '\" style=\"width:100%;\" onload=\"resizeIframe(this)\"></iframe></p>';\n    htmlModal += '</div>';\n    htmlModal += '<div class=\"modal-footer bigModal\">';\n    htmlModal += '<button type=\"button\" class=\"btn btn-default pull-left\" onclick=\"' + generateDocument + '\">Download PDF</button>';\n    htmlModal += '<button type=\"button\" class=\"btn btn-primary\" data-dismiss=\"modal\">Close</button>';\n    htmlModal += '</div>';\n    htmlModal += '</div>';\n    htmlModal += '</div>';\n    htmlModal += '</div>';\n    $(\"body\").append(htmlModal);\n\n    $(\"#modalView\").modal({\n        backdrop: 'static',\n        keyboard: false\n    });\n\n    //Verify if browser is internet explorer\n    var ms_ie = false;\n    var ua = window.navigator.userAgent;\n    var old_ie = ua.indexOf('MSIE ');\n    var new_ie = ua.indexOf('Trident/');\n\n    if ((old_ie > -1) || (new_ie > -1)) {\n        ms_ie = true;\n    }\n    //Remove class fade only if browser is internet explorer\n    if ( ms_ie ) {\n        $('.modal').removeClass('fade');\n    }\n}\n/**\n * Resize iframe\n * \n * @param (Object) obj\n * @return none\n *\n * by Ana Castillo\n */\nfunction resizeIframe(obj) {\n    obj.style.height = (document.getElementById(\"bodyModal\").scrollHeight - 4) + 'px';\n}\n\n/**\n * Cancel External Form\n * \n * @param (Object) objCancel\n * @return none\n *\n * by Ana Castillo\n */\nfunction cancelExternalForm(objCancel)\n{\n    //Get ssid\n    var idCancel = objCancel.id;\n    var rowNumber = idCancel.split(\"_\")[1];\n    var ssid = $(\"#SLFI_INVESTORS_GRID_TRACKING\").getValue(rowNumber, 6);\n\n    //Get application\n    var appUid = $(\"#APP_UID\").getValue();\n\n    //Ask to confirm the cancelation\n    var body = \"<p>Are you sure to cancel the Investor confirmation form?</p>\";\n    confirmMessage(\"cancelModal\", \"Cancel\", body, \"modalCancelYes\", \"modalCancelNo\");\n    $(\"#modalCancelYes\").on(\"click\", function() {\n        var aData = {};\n        aData[\"APP_UID\"] = appUid;\n        aData[\"SID_UID\"] = ssid;\n        $.ajax({\n            type: \"POST\",\n            url: \"../psSLFIFunctions/investorsController.php\",\n            data: {type: \"cancelInvestor\",\n                   aData: JSON.stringify(aData)},\n            dataType: 'JSON',\n            cache: false\n        }).done(function(data) {\n            if (data) {\n                $(\"#SLFI_INVESTORS_GRID_TRACKING\").setValue(\"Cancelled\", rowNumber, 8);\n                showHideButtonsGrid(rowNumber);\n            }\n        });\n    });\n}\n/**\n * Resent External Form email\n * \n * @param (Object) objResend\n * @return none\n *\n * by Ana Castillo\n * modified by Cinthia Romero\n */\nfunction reSentExternalForm(objResend)\n{\n    //Get ssid\n    var idRedend = objResend.id;\n    var rowNumber = idRedend.split(\"_\")[1];\n    var ssid = $(\"#SLFI_INVESTORS_GRID_TRACKING\").getValue(rowNumber, 6);\n    //Get email\n    var email = $(\"#SLFI_INVESTORS_GRID_TRACKING\").getValue(rowNumber, 1);\n    //Get Task Uid\n    var taskUid = $(\"#TASK_UID\").getValue();\n    //Get display Name\n    var displayName = $(\"#SLFI_INVESTORS_GRID_TRACKING\").getValue(rowNumber, 2);\n    //Get Investor Name\n    var investorName = $(\"#SLFI_INVESTORS_GRID_TRACKING\").getValue(rowNumber, 3);\n    //Get application\n    var appUid = $(\"#APP_UID\").getValue();\n    //Get appNumber\n    var appNumber = $(\"#CASE_NUMBER\").getValue();\n    //Get variables needed to the email\n    var contactInformation = $(\"#SLFI_CONTACT_INFORMATION\").getValue();\n    var currentYear = $(\"#SLFI_CURRENT_YEAR\").getValue();\n\n    //Ask to confirm the cancelation\n    var body = \"<p>Are you sure to re-send the email of this Investor?</p>\";\n    confirmMessage(\"resendModal\", \"Re-send\", body, \"modalResendYes\", \"modalresendNo\");\n    $(\"#modalResendYes\").on(\"click\", function() {\n        var aData = {};\n        aData[\"APP_UID\"] = appUid;\n        aData[\"APP_NUMBER\"] = appNumber;\n        aData[\"SID_UID\"] = ssid;\n        aData[\"email\"] = email;\n        aData[\"taskUid\"] = taskUid;\n        aData[\"displayName\"] = displayName;\n        aData[\"investorName\"] = investorName;\n        aData[\"contactInformation\"] = contactInformation;\n        aData[\"currentYear\"] = currentYear;\n        $.ajax({\n            type: \"POST\",\n            url: \"../psSLFIFunctions/investorsController.php\",\n            data: {type: \"resendInvestor\",\n                   aData: JSON.stringify(aData)},\n            dataType: 'JSON',\n            cache: false\n        }).done(function(data) {\n            var status = data['STATUS'];\n            var date = data['DATE'];\n            $(\"#SLFI_INVESTORS_GRID_TRACKING\").setValue(date, rowNumber, 7);\n            $(\"#SLFI_INVESTORS_GRID_TRACKING\").setValue(status, rowNumber, 8);\n            showHideButtonsGrid(rowNumber);\n        });\n    });\n}\n/**\n * Edit External Form information\n * \n * @param (Object) objEdit\n * @return none\n *\n * by Ana Castillo\n * modified by Cinthia Romero\n */\nfunction editExternalForm(objEdit)\n{\n    //Get ssid\n    var idEdit = objEdit.id;\n    var rowNumber = idEdit.split(\"_\")[1];\n    var ssid = $(\"#SLFI_INVESTORS_GRID_TRACKING\").getValue(rowNumber, 6);\n    //Get application\n    var appUid = $(\"#APP_UID\").getValue();\n    //Get investor clue for external form\n    var investorClueExternalForm = $(\"#SLFI_INVESTORS_GRID_TRACKING\").getValue(rowNumber, 14);\n    var encryptedInvestorClue = btoa(investorClueExternalForm);\n  \n    //Set link of the External Form\n    var externalLink = $(\"#SLFI_EXTERNAL_FORM\").getValue();\n    externalLink += \"?identifier=\" + encryptedInvestorClue + \"&type=EDIT\";\n\n    //Create modal html\n    $(\"#modalView\").remove();\n    var htmlModal = '<div id=\"modalView\" class=\"modal fade\"\">';\n    htmlModal += '<div class=\"modal-dialog bigModal\" style=\"width:90%;\">';\n    htmlModal += '<div class=\"modal-content bigModal\">';\n    htmlModal += '<div class=\"modal-header modalTitleColors\">';\n    htmlModal += '<center>';\n    htmlModal += '<b>Edit External Form</b>';\n    htmlModal += '</center>';\n    htmlModal += '</div>';\n    htmlModal += '<div id=\"bodyModal\" class=\"modal-body bigModal\">';\n    htmlModal += '<p><iframe id=\"externalform\" src=\"' + externalLink + '\" style=\"width:100%;\" onload=\"resizeIframe(this)\"></iframe></p>';\n    htmlModal += '</div>';\n    htmlModal += '<div class=\"modal-footer bigModal\">';\n    htmlModal += '<button id=\"closeEdit\" type=\"button\" class=\"btn btn-primary\" data-dismiss=\"modal\">Close</button>';\n    htmlModal += '</div>';\n    htmlModal += '</div>';\n    htmlModal += '</div>';\n    htmlModal += '</div>';\n    $(\"body\").append(htmlModal);\n\n    $(\"#modalView\").modal({\n        backdrop: 'static',\n        keyboard: false\n    });\n\n    $(\"#closeEdit\").on(\"click\", function() {\n        var aData = {};\n        aData[\"APP_UID\"] = appUid;\n        aData[\"SID_UID\"] = ssid;\n        $.ajax({\n            type: \"POST\",\n            url: \"../psSLFIFunctions/investorsController.php\",\n            data: {type: \"getInvestorStatus\",\n                   aData: JSON.stringify(aData)},\n            dataType: 'JSON',\n            cache: false\n        }).done(function(data) {\n            $(\"#SLFI_INVESTORS_GRID_TRACKING\").setValue(data, rowNumber, 8);\n            showHideButtonsGrid(rowNumber);\n        });\n    });\n\n    //Verify if browser is internet explorer\n    var ms_ie = false;\n    var ua = window.navigator.userAgent;\n    var old_ie = ua.indexOf('MSIE ');\n    var new_ie = ua.indexOf('Trident/');\n\n    if ((old_ie > -1) || (new_ie > -1)) {\n        ms_ie = true;\n    }\n    //Remove class fade only if browser is internet explorer\n    if ( ms_ie ) {\n        $('.modal').removeClass('fade');\n    }\n}\n\n/**\n * Copy Link to Clipboard\n *\n * @param object objCopyLink\n * @param int gridRow\n * @return none\n *\n * by Cinthia Romero\n */\nfunction copyLink(objCopyLink, gridRow)\n{\n    //Get uid and value of field to copy\n    var objCopyUid = objCopyLink.id;\n    var investorClueExternalForm = $(\"#SLFI_INVESTORS_GRID_TRACKING\").getValue(gridRow, 14);\n    var encryptedInvestorClue = btoa(investorClueExternalForm);\n  \n    //Set link of the External Form\n    var externalLink = $(\"#SLFI_EXTERNAL_FORM\").getValue();\n    externalLink += \"?identifier=\" + encryptedInvestorClue;\n    \n    //Copy to clipboard\n    var $temp = $(\"<input id='linkDelete'>\");\n    $(\"body\").append($temp);\n    $temp.val(externalLink).select();\n    document.execCommand(\"copy\");\n    $temp.remove();\n    //Message\n    var messageInvestorName = \"Investor \" + $(\"#SLFI_INVESTORS_GRID_TRACKING\").getValue(gridRow, 3) + \" link copied\";\n    showPopUpMessage(messageInvestorName, \"alert-success\");\n}\n\n/*\n * showPopUpMessage\n *\n * @param (string) messageText\n * @param (string) alertType\n * @return none\n *\n * by Cinthia Romero\n */\nfunction showPopUpMessage (messageText, alertType) {\n    \n    var message = $('<div class=\"alert ' + alertType + ' popUp-message\" style=\"display: none;\">');\n    var close = $('<button type=\"button\" class=\"close\" data-dismiss=\"alert\">&times</button>');\n    message.append(close);\n    message.append(messageText);\n    message.appendTo($('body')).fadeIn(500).delay(4000).fadeOut(500);\n}\n\n/*\n* Generate PDF document for the invertor\n*\n* @param appUid\n* @param ssid\n* @return none\n*\n* by Ana Castillo\n*/\nfunction generateDocument(appUid, ssid)\n{\n    var aData = {};\n    aData[\"APP_UID\"] = appUid;\n    aData[\"SID_UID\"] = ssid;\n    $.ajax({\n        type: \"POST\",\n        url: \"../psSLFIFunctions/investorsController.php\",\n        data: {type: \"generatePDF\",\n               aData: JSON.stringify(aData)},\n        dataType: 'JSON',\n        cache: false\n    }).done(function(data) {\n        window.open(data,'_blank');\n    });\n}\n\n/**\n * Send Reminder\n * \n * @param int onlyCheckCases\n * @return none\n *\n * by Cinthia Romero\n */\nfunction sendReminder(onlyCheckCases)\n{\n    $.ajax({\n        type: \"POST\",\n        url: \"../psSLFIFunctions/investorsController.php\",\n        data: {type: \"sendReminder\",\n               appUid: $(\"#APP_UID\").getValue(),\n               onlyCheckCases: onlyCheckCases},\n        dataType: 'JSON',\n        cache: false\n    }).done(function(data) {\n        $(\"#52437100460df88f44e3f49053436605\").hideFormModal();\n        if (data[\"success\"]) {\n            if (onlyCheckCases == 1 && data[\"blockButton\"]) {\n                $(\"#BTN_SEND_REMINDER button\").prop('disabled', true);\n            }\n            if (onlyCheckCases == 0 && data[\"errorMessage\"] != \"\") {\n                alertMessage(\"errorModal\", \"WARNING\", data[\"errorMessage\"], 1, \"\");\n            }\n            if (onlyCheckCases == 0 && data[\"errorMessage\"] == \"\") {\n                location.reload();\n            }\n        } else {\n            alertMessage(\"errorModal\", \"WARNING\", \"The emails could not be sent, please contact your system administrator\", 1, \"\");\n        }\n    });\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"SLFI_TRACKING_TITLE","label":"Investors Confirmation Tracking Task","ariaLabel":"","colSpan":12}],[{"colSpan":3},{"type":"datetime","variable":"SLFI_CURRENT_DATE","var_uid":"63945459460cb6e50b2bb32074968473","dataType":"datetime","protectedValue":false,"id":"SLFI_CURRENT_DATE","name":"SLFI_CURRENT_DATE","label":"Date","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"MMM Do, YYYY","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"SLFI_CURRENT_DATE","colSpan":6},{"colSpan":3}],[{"colSpan":3},{"type":"text","variable":"SLFI_SUBMITTER","var_uid":"24906670160cb6e9295e5e5028051084","dataType":"string","protectedValue":false,"id":"SLFI_SUBMITTER","name":"SLFI_SUBMITTER","label":"Name","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"SLFI_SUBMITTER","colSpan":6},{"colSpan":3}],[{"colSpan":3},{"type":"datetime","variable":"SLFI_EXPIRATION_DATE","var_uid":"31239748960ccffda578fd9006522268","dataType":"datetime","protectedValue":false,"id":"SLFI_EXPIRATION_DATE","name":"SLFI_EXPIRATION_DATE","label":"Expiration Date","tabIndex":"","placeholder":"","hint":"","ariaLabel":"",