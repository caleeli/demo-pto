      <record>
        <tri_uid>38145285560ecb3d84307e0039812125</tri_uid>
        <tri_title>Validates show or hide submit button</tri_title>
        <tri_description>Validates show or hide submit button with status of the grid</tri_description>
        <pro_uid>49495392760ca7026529f80008442485</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[/******************************************
* Validates show or hide submit button
*
* by Ana Castillo
* modified by Cinthia Romero
******************************************/
$showFlag = "YES";
$appUid = @@APPLICATION;

$sQValidate = "SELECT SID_UID,
                      SID_EMAIL,
                      SID_DISPLAY_NAME
               FROM PMT_SLFI_INVESTORS_DATA
               WHERE APP_UID = '$appUid'
				   AND (SID_STATUS = 'Pending'
				   OR SID_STATUS = 'Sent'
                   OR SID_STATUS = 'Re-sent')";
$rQValidate = executeQuery($sQValidate);
if (count($rQValidate) > 0) {
	$showFlag = "NO";
}

@@SLFI_FLAG_SUBMIT = $showFlag;]]></tri_webbot>
        <tri_param></tri_param>
      </record>
      <record>
        <tri_uid>43298803864553169aec472097994316</tri_uid>
        <tri_title>Check if button to send investors zip should be disabled</tri_title>
        <tri_description>This trigger will check if one day passed from the email date in order to enable or disable the button to send the email in the dynaform</tri_description>
        <pro_uid>49495392760ca7026529f80008442485</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[/*********************************************************
* Check if button to send investor zip should be disabled
*
* by Cinthia Romero
*********************************************************/
$queryGetZipMessageDate = "SELECT IZM_DATE
                           FROM PMT_SLFI_INVESTORS_ZIP_MESSAGE_HISTORY
                           WHERE APP_NUMBER = " . @@APP_NUMBER . "
                           ORDER BY IZM_UID DESC
                           LIMIT 1";    
$zipMessageInfo = executeQuery($queryGetZipMessageDate);
@@SLFI_DISABLED_BUTTON_INVESTORS_ZIP = 0;
if (count($zipMessageInfo) > 0) {
    $emailDate = $zipMessageInfo[1]["IZM_DATE"];
    $emailDateAddOneDay = strtotime($emailDate . ' +1 day');
    $currentDate = strtotime(date("Y-m-d H:i:s"));
    //Check if one day passed from the date when the email was sent, if so show a message, else prepare que download link
    if ($currentDate < $emailDateAddOneDay) {
    	@@SLFI_DISABLED_BUTTON_INVESTORS_ZIP = 1;
    }
}
//Check if at least one investor is completed, otherwise disable the button
$queryCheckCases = "SELECT COUNT(APP_UID) AS TOTAL
                    FROM PMT_SLFI_INVESTORS_DATA
                    WHERE SID_STATUS LIKE 'Completed%'
                        AND APP_UID = '" . @@APPLICATION . "'";
$totalCases = executeQuery($queryCheckCases);
if (count($totalCases) > 0 && $totalCases[1]["TOTAL"] == 0) {
    @@SLFI_DISABLED_BUTTON_INVESTORS_ZIP = 1;
}]]></tri_webbot>
        <tri_param></tri_param>
      </record>
      <record>
        <tri_uid>47114398860e6fc3fa3ef29098129748</tri_uid>
        <tri_title>Save Investors emails</tri_title>
        <tri_description><![CDATA[Save investor's emails into a PMtable to send later with a cron job]]></tri_description>
        <pro_uid>49495392760ca7026529f80008442485</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[/*****************************
* Save investor's emails
* by Ana Castillo
* modified by Cinthia Romero
*****************************/
date_default_timezone_set("America/New_York");
require_once PATH_PLUGINS . 'psSLFIFunctions/classes/class.phpLibrarySLFI.php';
$phpLibraryClass = new phpLibrarySLFI();
$appUid = @@APPLICATION;
$taskUid = @@TASK;
$template = "SLFIEmailTemplate.html";

//Get subject and body of the notification
$aData = array();
$aData['SLFI_CONTACT_INFORMATION'] = @@SLFI_CONTACT_INFORMATION;
$aData['SLFI_CURRENT_YEAR'] = @@SLFI_CURRENT_YEAR;
$notificationData = $phpLibraryClass->getNotificationData($taskUid, 'INVESTORS', $aData);
if (count($notificationData) > 0) {
    $subject = $notificationData["SBN_SUBJECT"];
    $body = $notificationData["SBN_BODY"];

	//Get all Investors users
	$sQInvestors = "SELECT SID_UID,
	                       SID_EMAIL,
	                       SID_DISPLAY_NAME,
	                       SID_INVESTOR_NAME
	                FROM PMT_SLFI_INVESTORS_DATA
	                WHERE APP_UID = '$appUid'
	                ORDER BY SID_UID ASC";
	$rQInvestors = executeQuery($sQInvestors);
    //Save Investor in Table to send email later
    for ($i = 1; $i <= count($rQInvestors); $i++) {
    	//Get Name and email of the investor
    	$sidUid = $rQInvestors[$i]['SID_UID'];
    	$displayName = $rQInvestors[$i]['SID_DISPLAY_NAME'];
    	$investorName = $rQInvestors[$i]['SID_INVESTOR_NAME'];
    	$investorEmail = $rQInvestors[$i]['SID_EMAIL'];
    	
    	//Set link of External Form
		$linkInvestors = $phpLibraryClass->getLinkInvestors(@@APP_NUMBER, $sidUid);
    	$bodyInvestor = str_replace("SLFI_LINK_INVESTORS", $linkInvestors, $body);
    	$bodyInvestor = str_replace("SLFI_INVESTOR_NAME", $investorName, $bodyInvestor);
		
		//Set status
		$status = "Sent";

		//Save investor
		$sQSave = "INSERT INTO PMT_SLFI_INVESTOR_EMAILS(APP_UID,
		                                                SIE_DISPLAY_NAME,
		                                                SIE_INVESTOR_EMAIL,
		                                                SIE_SUBJECT,
		                                                SIE_BODY,
		                                                SIE_TEMPLATE,
		                                                SIE_SID_UID,
		                                                SIE_STATUS,
		                                                SIE_SEND_EMAIL)
		           VALUES('$appUid',
		                  '" . $phpLibraryClass->pmEscapeString($displayName) . "',
		                  '" . $phpLibraryClass->pmEscapeString($investorEmail) . "',
		                  '" . $phpLibraryClass->pmEscapeString($subject) . "',
		                  '" . $phpLibraryClass->pmEscapeString($bodyInvestor) . "',
		                  '" . $phpLibraryClass->pmEscapeString($template) . "',
		                  " . $sidUid . ",
		                  '" . $status . "',
		                  'NO')";
		executeQuery($sQSave);
    }
}]]></tri_webbot>
        <tri_param></tri_param>
      </record>
