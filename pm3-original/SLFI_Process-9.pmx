    <table name="triggers">
      <record>
        <tri_uid>12499631260d635f82999d1029512283</tri_uid>
        <tri_title>Set logo</tri_title>
        <tri_description>This trigger will set the image url and the full html for the logo</tri_description>
        <pro_uid>49495392760ca7026529f80008442485</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[/********************
* Set logo
* by Ana Castillo
********************/
if (g::is_https()) {
     $httpServer = 'https://';
} else {
     $httpServer = 'http://';
}
$imageUrl = $httpServer . $_SERVER['HTTP_HOST'] . "/plugin/psSLFIFunctions/images/northleaf_logo_small.png";
@@IMG_LOGO = "<img src='" . $imageUrl . "' style='margin-bottom:10px;width:200px;'>";]]></tri_webbot>
        <tri_param></tri_param>
      </record>
      <record>
        <tri_uid>14881206260e6f5348ad4e3019754141</tri_uid>
        <tri_title>Remove Assign Screen</tri_title>
        <tri_description>Remove the assignment screen</tri_description>
        <pro_uid>49495392760ca7026529f80008442485</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[/***********************
* Remove Assign Screen
* by Ana Castillo
************************/
PMFDerivateCase(@@APPLICATION, @%INDEX);
G::header("Location: casesListExtJsRedirector");
die();]]></tri_webbot>
        <tri_param></tri_param>
      </record>
