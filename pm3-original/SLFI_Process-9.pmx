      <record>
        <tri_uid>85464286460d629c0724d71048875741</tri_uid>
        <tri_title>Send Notifications</tri_title>
        <tri_description>Send notifications into the process</tri_description>
        <pro_uid>49495392760ca7026529f80008442485</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[/***********************
* Send Notifications
* by Ana Castillo
* Modified by Helen Callisaya
***********************/
require_once PATH_PLUGINS . 'psSLFIFunctions/classes/class.phpLibrarySLFI.php';
$phpLibraryClass = new phpLibrarySLFI();
$g = new G();

$appUid = @@APPLICATION;
$taskUid = @@TASK;
$template = "SLFIEmailTemplate.html";
switch($taskUid) {
    //Submit Investor Confirmation Form
    case '37012459760ca70ef951c71095717114':
        $notificationData = $phpLibraryClass->getNotificationData($taskUid, 'SUBMIT', array());
        if (count($notificationData) > 0) {
            $subject = $notificationData["SBN_SUBJECT"];
            $body = $notificationData["SBN_BODY"];

            //Send notification to Tax group of users
            $aUsers = PMFGetGroupUsers("7129995195eb9a1048f3df7005519636");
            for ($l = 0; $l < count($aUsers); $l++) {
			    $phpLibraryClass->sendNotification($appUid, $aUsers[$l]['USR_UID'], $subject, $body, $template, array());
            }
        }
        break;
    //Review Investors List
    case '79391920060ca7117742054032410881':
    	if (@@SLFI_FLAG_CANCEL_CASE != "") {
	    	//Send notification to the first task user
            if (@@SLFI_FLAG_CANCEL_CASE == "RETURN") {
                $notificationData = $phpLibraryClass->getNotificationData($taskUid, 'RETURN', array());
            } else {
                //Flag is Cancel
                $notificationData = $phpLibraryClass->getNotificationData($taskUid, 'CANCEL', array());
            }
	        if (count($notificationData) > 0) {
	            $subject = $notificationData["SBN_SUBJECT"];
	            $body = $notificationData["SBN_BODY"];

	            //Send notification to the tax user 
	            if (@@SLFI_TAX_USER != '') {
				    $phpLibraryClass->sendNotification($appUid, @@SLFI_TAX_USER, $subject, $body, $template, array());
	            }
	        }
    	} else {
	    	//Send notification to the next user
	        $notificationData = $phpLibraryClass->getNotificationData($taskUid, 'SUBMIT', array());
	        if (count($notificationData) > 0) {
	            $subject = $notificationData["SBN_SUBJECT"];
	            $body = $notificationData["SBN_BODY"];

	            //Send notification to the tax user 
	            if (@@SLFI_TAX_USER != '') {
				    $phpLibraryClass->sendNotification($appUid, @@SLFI_TAX_USER, $subject, $body, $template, array());
	            }
	        }
	        //Send notification to the Investors
	        /*$notificationData = $phpLibraryClass->getNotificationData($taskUid, 'INVESTORS', array());
	        if (count($notificationData) > 0) {
	            $subject = $notificationData["SBN_SUBJECT"];
	            $body = $notificationData["SBN_BODY"];

				//Get all Investors users
				$sQInvestors = "SELECT SID_UID,
				                       SID_EMAIL,
				                       SID_DISPLAY_NAME
				                FROM PMT_SLFI_INVESTORS_DATA
				                WHERE APP_UID = '$appUid'
				                ORDER BY SID_UID ASC";
				$rQInvestors = executeQuery($sQInvestors);
	            //Send notification to all investors
	            for ($i = 1; $i <= count($rQInvestors); $i++) {
	            	//Set link of External Form
					$linkInvestors = $phpLibraryClass->getLinkInvestors($appUid, $rQInvestors[$i]['SID_UID']);
                	$bodyInvestor = str_replace("SLFI_LINK_INVESTORS", $linkInvestors, $body);

                	//Get Name and email of the investor
                	$investorName = $rQInvestors[$i]['SID_DISPLAY_NAME'];
                	$investorEmail = $rQInvestors[$i]['SID_EMAIL'];
					
					//Set status
					$status = "Sent";

                	//Send notification to the investor
				    $phpLibraryClass->sendNotificationInvestor($appUid, $investorName, $investorEmail, $subject, $bodyInvestor, $template, array(), $rQInvestors[$i]['SID_UID'], $status);
	            }
	        }*/
    	}
        break;
}]]></tri_webbot>
