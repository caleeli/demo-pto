      <record>
        <tri_uid>75926963560cca6b5d48ae4078506178</tri_uid>
        <tri_title><![CDATA[Read file, save it into the table and populate grid]]></tri_title>
        <tri_description><![CDATA[Read the file, save it into the table and populate into the grid]]></tri_description>
        <pro_uid>49495392760ca7026529f80008442485</pro_uid>
        <tri_type>SCRIPT</tri_type>
        <tri_webbot><![CDATA[/***************************************
* Read file, save it into the table
* and save it into the grid
* by Ana Castillo
* modified by Cinthia Romero
****************************************/
ini_set('max_execution_time', 0);
ini_set('memory_limit', '-1');

require_once PATH_PLUGINS . 'psSLFIFunctions/classes/class.investorsData.php';
$investorsClass = new investorsData();
g::pr($investorsClass);
die();
//Set variables to read the file
$expirationDate = @@SLFI_EXPIRATION_DATE;
$appUid = @@APPLICATION;
$uploadFile = @@SLFI_UPLOAD_INVESTORS;

//Delete all rows into the table
$sQDelete = "DELETE FROM PMT_SLFI_INVESTORS_DATA
             WHERE APP_UID = '$appUid'";
executeQuery($sQDelete);

//Fill the grid
$arrayData = $investorsClass->saveGridInvestors($appUid, $uploadFile, $expirationDate);
@=SLFI_INVESTORS_GRID = $arrayData;]]></tri_webbot>
        <tri_param></tri_param>
      </record>
