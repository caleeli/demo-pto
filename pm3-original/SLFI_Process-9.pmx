        <dyn_content><![CDATA[{"name":"Review Investors List","description":"Review Investors List second task","items":[{"type":"form","variable":"","var_uid":"","dataType":"","id":"22396521760ccee338b6f71023598418","name":"Review Investors List","description":"Review Investors List second task","mode":"edit","script":{"type":"js","code":"$(document).ready(function() {\n    //Remove backward and forward buttons\n    $(\"#dyn_forward\").parent().hide();\n  \n    //Set libraries\n    var random = Math.random();\n    $(\"head\").append('<script type=\"text/javascript\" src=\"/plugin/psSLFIFunctions/js/javascriptLibrary.js?random=\"' + random + '\" />');\n\n    //Set array to set the rows modified of the grid\n    var updateGridArray = [];\n    //Clean flag cancel case\n    $(\"#SLFI_FLAG_CANCEL_CASE\").setValue(\"\");\n    //Preview Buttons\n    $(\"#SLFI_CANCEL_CASE button\").click(function() {\n        confirmMessage(\"cancelCase\", \"Cancel Case\", \"<p>Are you sure to Cancel Case?</p>\", \"modalBtnYes\", \"modalBtnNo\");\n        $(\"#modalBtnYes\").on(\"click\", function() {\n            $(\"#SLFI_FLAG_CANCEL_CASE\").setValue(\"1\");\n            $(\"#22396521760ccee338b6f71023598418\").submitForm();\n        });\n    });\n    //Return First Task\n    $(\"#SLFI_RETURN_CASE button\").click(function() {\n        $(\"#SLFI_FLAG_CANCEL_CASE\").setValue(\"RETURN\");\n        $(\"#SLFI_BACK_FORM\").setValue(\"\");\n        $(\"#22396521760ccee338b6f71023598418\").submitForm();\n    });\t\n  \n    $(\"#22396521760ccee338b6f71023598418\").setOnchange( function( fieldID, newValue, oldValue) {\n        //Validate if the field is the grid\n        var rowGridUpdate = fieldID.split(\"]\");\n        if (rowGridUpdate.length > 1) {\n            //Get row of the grid\n            rowGridUpdate = rowGridUpdate[1].split('[')[1];\n\n            //Validate if the row is not in the update Array\n            if (jQuery.inArray(rowGridUpdate, updateGridArray) == -1) {\n                updateGridArray.push(rowGridUpdate);\n            }\n        }\n    });\n  \n    //Submit form\n    $(\"#SUBMIT\").find(\"button\").on(\"click\" , function() {\n        if (updateGridArray.length > 0) {\n            var rowsMissingInfo = [];\n            for (var investor = 0; investor < updateGridArray.length; investor++) {\n                var gridRow = updateGridArray[investor];\n                var rowEmails = $(\"#SLFI_INVESTORS_GRID\").getValue(gridRow, 1);\n                //Split emails by comma\n                rowEmails = rowEmails.split(\",\");\n                //Remove all empty values\n                var rowEmailsCleaned = rowEmails.filter(function checkAdult(email) {\n                    var regex = /[a-zA-Z\\d]/g;\n                    return regex.test(email);\n                });\n                var rowNames = $(\"#SLFI_INVESTORS_GRID\").getValue(gridRow, 2);\n                //Split names by comma\n                rowNames = rowNames.split(\",\");\n                //Remove all empty values\n                var rowNamesCleaned = rowNames.filter(function checkAdult(name) {\n                    var regex = /[a-zA-Z\\d]/g;\n                    return regex.test(name);\n                });\n                //Check if exist the same number of emails and names\n                if (rowEmailsCleaned.length != rowNamesCleaned.length) {\n                    rowsMissingInfo.push(gridRow);\n                }\n                if((investor + 1) == updateGridArray.length) {\n                    if (rowsMissingInfo.length == 0) {\n                        saveDataInvestorsGrid(updateGridArray, \"SUBMIT\");\n                    } else {\n                        //Concat the rows which have error\n                        var errorRows = rowsMissingInfo.join(\", \");\n                        alertMessage(\"incorrectEmailsModal\", \"WARNING\", \"Missing Information in row: \" + errorRows + \". Remember the number of Emails should be the same as the number of Names described in the grid.\", 1, \"\");\n                    }\n                }\n            }\n        } else {\n            confirmMessage(\"sendEmail\", \"Send Investor's Email\", \"<p>Are you sure to send the email to the whole list of investors?</p>\", \"modalBtnYesSubmit\", \"modalBtnNoSubmit\");\n            $(\"#modalBtnYesSubmit\").on(\"click\", function() {\n                $(\"#22396521760ccee338b6f71023598418\").submitForm();\n            });\n        }\n        return false;\n    });\n  \n    //Save form\n    $(\"#SAVE\").find(\"button\").on(\"click\" , function() {\n        //Save dynaform\n        if (updateGridArray.length > 0) {\n            saveDataInvestorsGrid(updateGridArray, \"SAVE\"); \n        } else {\n            $(\"#22396521760ccee338b6f71023598418\").showFormModal();\n            $(\"#22396521760ccee338b6f71023598418\").saveForm();\n            $(\"#22396521760ccee338b6f71023598418\").hideFormModal();\n        }\n    });\n});\n\n/**\n* Save data updated in the investors grid\n*\n* @param (Array) updateGridArray\n* @param (String) typeSave\n* @return none\n*\n* by Ana Castillo\n* modified by Cinthia Romero\n*/\nfunction saveDataInvestorsGrid(updateGridArray, typeSave)\n{\n    //Add loading\n    $(\"#22396521760ccee338b6f71023598418\").showFormModal();\n\n    setTimeout(function(){\n        var aDataGrid = [];\n        for (var g = 0; g < updateGridArray.length; g++) {\n            //Set all data of the row to save data\n            var rowGrid = updateGridArray[g];\n            var rowData = {};\n            var rowEmails = $(\"#SLFI_INVESTORS_GRID\").getValue(rowGrid, 1)\n            //Split emails by comma\n            rowEmails = rowEmails.split(\",\");\n            //Remove empty values\n            var rowEmailsCleaned = rowEmails.filter(function checkAdult(email) {\n                var regex = /[a-zA-Z\\d]/g;\n                return regex.test(email);\n            });\n            //Join all cleaned emails by comma\n            rowEmailsCleaned = rowEmailsCleaned.join(\",\");\n            var rowNames = $(\"#SLFI_INVESTORS_GRID\").getValue(rowGrid, 2);\n            //Split names by comma\n            rowNames = rowNames.split(\",\");\n            //Remove empty values\n            var rowNamesCleaned = rowNames.filter(function checkAdult(name) {\n                var regex = /[a-zA-Z\\d]/g;\n                return regex.test(name);\n            });\n            //Join all cleaned names by comma\n            rowNamesCleaned = rowNamesCleaned.join(\",\");\n            rowData['EMAIL'] = rowEmailsCleaned;\n            rowData['DISPLAY_NAME'] = rowNamesCleaned;\n            rowData['INVESTOR_NAME'] = $(\"#SLFI_INVESTORS_GRID\").getValue(rowGrid, 3);\n            rowData['INVESTOR_ID'] = $(\"#SLFI_INVESTORS_GRID\").getValue(rowGrid, 4);\n            rowData['CLASS'] = $(\"#SLFI_INVESTORS_GRID\").getValue(rowGrid, 5);\n            rowData['UID'] = $(\"#SLFI_INVESTORS_GRID\").getValue(rowGrid, 6);\n\n            //Add Row data to the array\n            aDataGrid.push(rowData);\n\n            if (g == (updateGridArray.length - 1)) {\n                $.ajax({\n                    type: \"POST\",\n                    url: \"../psSLFIFunctions/investorsController.php\",\n                    data: {type: \"updateInvestors\",\n                           aData: JSON.stringify(aDataGrid)},\n                    dataType: 'JSON',\n                    cache: false\n                }).done(function(data) {\n                    //Remove loading screen\n                    $(\"#22396521760ccee338b6f71023598418\").hideFormModal();\n                    if (typeSave == 'SUBMIT') {\n                        confirmMessage(\"sendEmail\", \"Send Investor's Email\", \"<p>Are you sure to send the email to the whole list of investors?</p>\", \"modalBtnYesSubmit\", \"modalBtnNoSubmit\");\n                        $(\"#modalBtnYesSubmit\").on(\"click\", function() {\n                            $(\"#22396521760ccee338b6f71023598418\").submitForm();\n                        });\n                    } else {\n                        $(\"#22396521760ccee338b6f71023598418\").saveForm();\n                    }\n                });\n            }\n        }\n    }, 2000);\n}"},"language":"en","externalLibs":"","printable":false,"items":[[{"type":"title","id":"SLFI_REVIEW_TITLE","label":"Review Investors List","ariaLabel":"","colSpan":12}],[{"colSpan":3},{"type":"datetime","variable":"SLFI_CURRENT_DATE","var_uid":"63945459460cb6e50b2bb32074968473","dataType":"datetime","protectedValue":false,"id":"SLFI_CURRENT_DATE","name":"SLFI_CURRENT_DATE","label":"Date","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","mode":"disabled","format":"MMM Do, YYYY","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"SLFI_CURRENT_DATE","colSpan":6},{"colSpan":3}],[{"colSpan":3},{"type":"text","variable":"SLFI_SUBMITTER","var_uid":"24906670160cb6e9295e5e5028051084","dataType":"string","protectedValue":false,"id":"SLFI_SUBMITTER","name":"SLFI_SUBMITTER","label":"Name","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"disabled","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"var_name":"SLFI_SUBMITTER","colSpan":6},{"colSpan":3}],[{"colSpan":3},{"type":"datetime","variable":"SLFI_EXPIRATION_DATE","var_uid":"31239748960ccffda578fd9006522268","dataType":"datetime","protectedValue":false,"id":"SLFI_EXPIRATION_DATE","name":"SLFI_EXPIRATION_DATE","label":"Expiration Date","tabIndex":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","mode":"parent","format":"MMM Do, YYYY","dayViewHeaderFormat":"MMMM YYYY","extraFormats":false,"stepping":1,"minDate":"@@SLFI_MIN_EXPIRATION_DATE","maxDate":"","useCurrent":"false","collapse":true,"locale":"","defaultDate":"","disabledDates":false,"enabledDates":false,"icons":{"time":"glyphicon glyphicon-time","date":"glyphicon glyphicon-calendar","up":"glyphicon glyphicon-chevron-up","down":"glyphicon glyphicon-chevron-down","previous":"glyphicon glyphicon-chevron-left","next":"glyphicon glyphicon-chevron-right","today":"glyphicon glyphicon-screenshot","clear":"glyphicon glyphicon-trash"},"useStrict":false,"sideBySide":false,"daysOfWeekDisabled":false,"calendarWeeks":false,"viewMode":"days","toolbarPlacement":"default","showTodayButton":false,"showClear":"false","widgetPositioning":{"horizontal":"auto","vertical":"auto"},"widgetParent":null,"keepOpen":false,"var_name":"SLFI_EXPIRATION_DATE","colSpan":6},{"colSpan":3}],[{"type":"hidden","variable":"SLFI_FLAG_CANCEL_CASE","var_uid":"16491227660d1e4266a1824046069081","dataType":"string","protectedValue":false,"id":"SLFI_FLAG_CANCEL_CASE","name":"SLFI_FLAG_CANCEL_CASE","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"SLFI_FLAG_CANCEL_CASE","colSpan":12}],[{"type":"grid","variable":"SLFI_INVESTORS_GRID","var_uid":"34516674260ccf35d9ab887061269756","dataType":"grid","protectedValue":false,"id":"SLFI_INVESTORS_GRID","name":"SLFI_INVESTORS_GRID","label":"","hint":"","required":false,"requiredFieldErrorMessage":"","columns":[{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"SLFI_GRID_INVESTORS_EMAIL","name":"SLFI_GRID_INVESTORS_EMAIL","label":"Email","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","validate":"^[\\W]*([\\w+'\\-.%]+@[\\w\\-.]+\\.[A-Za-z]+[\\W]*,{1}[\\W]*)*([\\w+'\\-.%]+@[\\w\\-.]+\\.[A-Za-z]+)[\\W]*$","validateMessage":"Invalid Email","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"2","columnWidth":"24","width":100,"title":"Email"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"SLFI_GRID_INVESTORS_DISPLAY_NAME","name":"SLFI_GRID_INVESTORS_DISPLAY_NAME","label":"Display Name","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"2","columnWidth":"24","width":100,"title":"Display Name"},{"type":"textarea","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"SLFI_GRID_INVESTORS_INVESTOR_NAME","name":"SLFI_GRID_INVESTORS_INVESTOR_NAME","label":"Investor Name","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":true,"requiredFieldErrorMessage":"","validate":"","validateMessage":"","mode":"parent","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"rows":"2","columnWidth":"20","width":100,"title":"Investor Name"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"SLFI_GRID_INVESTORS_INVESTOR_ID","name":"SLFI_GRID_INVESTORS_INVESTOR_ID","label":"Investor ID","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"10","width":100,"title":"Investor ID"},{"type":"text","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"SLFI_GRID_INVESTORS_CLASS","name":"SLFI_GRID_INVESTORS_CLASS","label":"Class","tabIndex":"","defaultValue":"","placeholder":"","hint":"","ariaLabel":"","required":false,"requiredFieldErrorMessage":"","textTransform":"none","validate":"","validateMessage":"","maxLength":1000,"formula":"","mode":"parent","operation":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","memoryCache":false,"columnWidth":"18","width":100,"title":"Class"},{"type":"hidden","variable":"","var_uid":"","dataType":"","protectedValue":false,"id":"SLFI_GRID_INVESTORS_UID","name":"SLFI_GRID_INVESTORS_UID","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","width":100}],"data":[],"mode":"edit","layout":"responsive","pageSize":"0","addRow":false,"deleteRow":false,"title":"","colSpan":12}],[{"colSpan":2},{"type":"button","id":"SLFI_CANCEL_CASE","name":"SLFI_CANCEL_CASE","label":"Cancel Case","tabIndex":"","ariaLabel":"","colSpan":2},{"type":"button","id":"SAVE","name":"SAVE","label":"Save","tabIndex":"","ariaLabel":"","colSpan":2},{"type":"button","id":"SLFI_RETURN_CASE","name":"SLFI_RETURN_CASE","label":"Re-upload Investors list","tabIndex":"","ariaLabel":"","colSpan":2},{"type":"submit","id":"SUBMIT","name":"SUBMIT","label":"Send Bulk email","tabIndex":"","ariaLabel":"","colSpan":2},{"colSpan":2}],[{"type":"hidden","variable":"SLFI_BACK_FORM","var_uid":"86052484860cca2fd52a413006611353","dataType":"string","protectedValue":false,"id":"SLFI_BACK_FORM","name":"SLFI_BACK_FORM","defaultValue":"","dbConnection":"workflow","dbConnectionLabel":"PM Database","sql":"","var_name":"SLFI_BACK_FORM","colSpan":12}]],"variables":[{"var_uid":"63945459460cb6e50b2bb32074968473","prj_uid":"49495392760ca7026529f80008442485","var_name":"SLFI_CURRENT_DATE","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"24906670160cb6e9295e5e5028051084","prj_uid":"49495392760ca7026529f80008442485","var_name":"SLFI_SUBMITTER","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"31239748960ccffda578fd9006522268","prj_uid":"49495392760ca7026529f80008442485","var_name":"SLFI_EXPIRATION_DATE","var_field_type":"datetime","var_field_size":10,"var_label":"datetime","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"16491227660d1e4266a1824046069081","prj_uid":"49495392760ca7026529f80008442485","var_name":"SLFI_FLAG_CANCEL_CASE","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""},{"var_uid":"86052484860cca2fd52a413006611353","prj_uid":"49495392760ca7026529f80008442485","var_name":"SLFI_BACK_FORM","var_field_type":"string","var_field_size":10,"var_label":"string","var_dbconnection":"workflow","var_dbconnection_label":"PM Database","var_sql":"","var_null":0,"var_default":"","var_accepted_values":"[]","inp_doc_uid":""}]}]}]]></dyn_content>
