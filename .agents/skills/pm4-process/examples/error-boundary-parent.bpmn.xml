<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:pm="http://processmaker.com/BPMN/2.0/Schema.xsd" id="Definitions_ErrorParent" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="ErrorParent" name="HandleChildError" isExecutable="true">
    <bpmn:startEvent id="error_parent_start" name="Call validation"><bpmn:outgoing>error_parent_enter</bpmn:outgoing></bpmn:startEvent>
    <bpmn:callActivity id="error_parent_call" name="ErrorEndingChild" calledElement="ErrorChild-CHILD_PROCESS_ID" pm:config="{&quot;calledElement&quot;:&quot;ErrorChild-CHILD_PROCESS_ID&quot;,&quot;processId&quot;:CHILD_PROCESS_ID,&quot;startEvent&quot;:&quot;error_child_start&quot;,&quot;name&quot;:&quot;ErrorEndingChild&quot;}">
      <bpmn:incoming>error_parent_enter</bpmn:incoming><bpmn:outgoing>error_parent_normal</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="error_parent_catch" name="Catch child error" attachedToRef="error_parent_call" cancelActivity="true"><bpmn:outgoing>error_parent_recover</bpmn:outgoing><bpmn:errorEventDefinition id="error_parent_catch_definition" /></bpmn:boundaryEvent>
    <bpmn:task id="error_parent_handle" name="Handle rejected outcome" pm:screenRef="FORM_SCREEN_ID" pm:assignment="requester"><bpmn:incoming>error_parent_recover</bpmn:incoming><bpmn:outgoing>error_parent_handled</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="error_parent_success" name="Child completed normally"><bpmn:incoming>error_parent_normal</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="error_parent_end" name="Rejection handled"><bpmn:incoming>error_parent_handled</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="error_parent_enter" sourceRef="error_parent_start" targetRef="error_parent_call" />
    <bpmn:sequenceFlow id="error_parent_normal" sourceRef="error_parent_call" targetRef="error_parent_success" />
    <bpmn:sequenceFlow id="error_parent_recover" sourceRef="error_parent_catch" targetRef="error_parent_handle" />
    <bpmn:sequenceFlow id="error_parent_handled" sourceRef="error_parent_handle" targetRef="error_parent_end" />
  </bpmn:process>
