    <bpmndi:BPMNEdge id="error_parent_recover_di" bpmnElement="error_parent_recover"><di:waypoint x="298" y="194" /><di:waypoint x="298" y="298" /><di:waypoint x="400" y="298" /></bpmndi:BPMNEdge>
